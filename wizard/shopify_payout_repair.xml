<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="shopify_payout_repair_audit_company_rule" model="ir.rule">
        <field name="name">Shopify payout repair audit company</field>
        <field name="model_id" ref="model_shopify_payout_repair_audit_ept"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="shopify_payout_repair_workspace_company_rule" model="ir.rule">
        <field name="name">Shopify payout repair workspace company</field>
        <field name="model_id" ref="model_shopify_payout_repair_ept"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="shopify_payout_repair_case_company_rule" model="ir.rule">
        <field name="name">Shopify payout repair progress company</field>
        <field name="model_id" ref="model_shopify_payout_repair_line_ept"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="shopify_payout_repair_history_company_rule" model="ir.rule">
        <field name="name">Shopify payout repair history company</field>
        <field name="model_id" ref="model_shopify_payout_repair_history_ept"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="view_shopify_payout_bulk_repair" model="ir.ui.view">
        <field name="name">shopify.payout.bulk.repair.form</field>
        <field name="model">shopify.payout.repair.ept</field>
        <field name="arch" type="xml">
            <form string="Bulk Repair Payout Transactions" create="false" delete="false">
                <field name="preview_settings" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="payout_ids" widget="many2many_tags"/>
                <group>
                    <group><field name="cutover_date"/><field name="timezone"/><field name="sales_journal_id"/></group>
                    <group><field name="post_historical"/><field name="open_only"/><field name="rematch_payouts"/></group>
                </group>
                <group string="Cash Included in Opening Balances">
                    <field name="clear_historical_collections"/>
                    <field name="historical_collection_account_id"/>
                </group>
                <div class="alert alert-info" role="alert">
                    Refunds on or after cutover record proven returns and refund payments using the configured accounts.
                    Collections and refunds before cutover can clear unsettled cash included in the selected opening-balance account.
                    Enable that option only when their original sales, returns and taxes are already included in migration balances.
                    Apply creates or reuses the reviewed accounting and reconciles the payout in the same run by default.
                    Review the accounts and adjustments in Details before applying.
                    Inventory returns are handled separately. This action never sends money or customer notifications.
                </div>
                <field name="result" nolabel="1"/>
                <field name="progress_summary" nolabel="1"/>
                <group><field name="queue_filter"/><field name="issue_filter"/></group>
                <div class="mb-2">
                    <button name="action_select_ready" type="object" string="Select Ready in This Filter" class="btn-secondary"/>
                    <button name="action_select_pilot" type="object" string="Select First 10 Ready" class="btn-secondary"/>
                    <button name="action_clear_selection" type="object" string="Clear Selection" class="btn-secondary"/>
                </div>
                <field name="selection_summary" nolabel="1"/>
                <field name="visible_line_ids" nolabel="1" readonly="0">
                    <list editable="bottom" create="false" delete="false" decoration-danger="status == 'review' and reconciliation_status != 'matched'"
                          decoration-success="reconciliation_status == 'matched'"
                          decoration-warning="status == 'done' and reconciliation_status == 'pending'">
                        <field name="selected" readonly="status != 'ready'"/>
                        <field name="status"/><field name="reconciliation_status"/><field name="kind"/><field name="source_reference"/><field name="current_order_id"/>
                        <field name="last_preview_at" optional="hide"/><field name="last_apply_at" optional="hide"/>
                        <field name="last_error" optional="hide"/>
                        <field name="transaction_ids" widget="many2many_tags" optional="hide"/>
                        <field name="summary"/><field name="detail" optional="hide"/>
                        <field name="resolution" optional="show"/><field name="next_step" optional="show"/>
                        <field name="can_import_customer" column_invisible="1"/>
                        <field name="can_link_credit" column_invisible="1"/>
                        <field name="dependency_order_id" optional="hide"/>
                        <button name="action_open_details" string="Details" type="object"/>
                        <button name="action_review_payments" string="Review Payments" type="object" groups="account.group_account_manager"
                                invisible="not current_order_id or reconciliation_status == 'matched'"/>
                        <button name="action_open_accounting_documents" string="Invoices / Credits" type="object" invisible="not current_order_id"/>
                        <button name="action_link_refund_credit_note" string="Link Credit Note" type="object" invisible="not can_link_credit"/>
                        <button name="action_import_customer" string="Import Customer" type="object" groups="account.group_account_manager"
                                invisible="not can_import_customer"/>
                        <button name="action_open_dependency_order" string="Dependency in Shopify" type="object" invisible="not dependency_order_id"/>
                        <button name="action_review_dependency_import" string="Review Order Import" type="object" groups="account.group_account_manager" invisible="not dependency_order_id"/>
                        <button name="action_open_order" string="Open Order" type="object" invisible="not current_order_id"/>
                        <button name="action_open_shopify_order" string="Shopify" type="object" invisible="dependency_order_id"/>
                        <button name="action_refresh_case" string="Refresh Case" type="object"/>
                    </list>
                </field>
                <footer>
                    <button name="action_preview" type="object" string="Preview / Refresh" class="btn-primary"/>
                    <button name="action_apply" type="object" string="Apply Selected Ready Cases" invisible="not preview_settings"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_shopify_payout_repair_case" model="ir.ui.view">
        <field name="name">shopify.payout.repair.case.form</field>
        <field name="model">shopify.payout.repair.line.ept</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <group><field name="status"/><field name="reconciliation_status"/><field name="kind"/><field name="source_reference"/><field name="current_order_id"/>
                    <field name="last_preview_at"/><field name="last_apply_at"/><field name="last_error"/>
                    <field name="transaction_ids" widget="many2many_tags"/>
                    <field name="credit_ids" widget="many2many_tags"/><field name="payment_ids" widget="many2many_tags"/>
                    <field name="collection_move_ids" widget="many2many_tags"/></group>
                <field name="resolution"/><field name="next_step"/><field name="detail"/><field name="review_html" nolabel="1"/>
                <field name="can_import_customer" invisible="1"/>
                <field name="can_link_credit" invisible="1"/>
                <field name="dependency_order_id" invisible="not dependency_order_id"/>
                <field name="evidence_html" nolabel="1"/>
                <field name="history_ids" readonly="1">
                    <list create="false" edit="false" delete="false" default_order="id desc">
                        <field name="create_date"/><field name="create_uid"/><field name="operation"/>
                        <field name="status"/><field name="reconciliation_status"/><field name="detail"/>
                    </list>
                </field>
                <footer><button name="action_open_order" type="object" string="Open Order" invisible="not current_order_id"/>
                    <button name="action_review_payments" type="object" string="Review Payments" groups="account.group_account_manager"
                            invisible="not current_order_id or reconciliation_status == 'matched'"/>
                    <button name="action_open_accounting_documents" type="object" string="Invoices / Credits"
                            invisible="not current_order_id and not credit_ids"/>
                    <button name="action_link_refund_credit_note" type="object" string="Link Refund Credit Note" groups="account.group_account_manager" invisible="not can_link_credit"/>
                    <button name="action_import_customer" type="object" string="Import Customer" groups="account.group_account_manager"
                            invisible="not can_import_customer"/>
                    <button name="action_open_dependency_order" type="object" string="Dependency in Shopify" invisible="not dependency_order_id"/>
                    <button name="action_review_dependency_import" type="object" string="Review Order Import" groups="account.group_account_manager" invisible="not dependency_order_id"/>
                    <button name="action_open_shopify_order" type="object" string="Open Shopify Order" invisible="dependency_order_id"/>
                    <button name="action_refresh_case" type="object" string="Refresh Case" groups="account.group_account_manager"/>
                    <button name="action_back_to_bulk_repair" type="object" string="Back to Bulk Repair" class="btn-primary"/>
                    <button string="Close" special="cancel"/></footer>
            </form>
        </field>
    </record>
    <record id="view_payout_bulk_repair_button" model="ir.ui.view">
        <field name="name">shopify.payout.bulk.repair.button</field>
        <field name="model">shopify.payout.report.ept</field>
        <field name="inherit_id" ref="shopify_payout_report_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_bulk_repair_transactions" type="object" string="Bulk Repair Transactions" groups="account.group_account_manager"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Bulk Repair Audit" groups="account.group_account_user">
                    <group string="Current Repair Progress">
                        <field name="repair_case_ids" readonly="1" nolabel="1">
                            <list create="false" edit="false" delete="false"
                                  decoration-danger="status == 'review' and reconciliation_status != 'matched'"
                                  decoration-success="reconciliation_status == 'matched'">
                                <field name="status"/><field name="reconciliation_status"/><field name="kind"/>
                                <field name="source_reference"/><field name="current_order_id"/>
                                <field name="last_preview_at" optional="hide"/><field name="last_apply_at" optional="hide"/>
                                <field name="summary"/><field name="detail" optional="hide"/><field name="last_error" optional="hide"/>
                                <field name="resolution" optional="show"/><field name="next_step" optional="show"/>
                                <field name="can_import_customer" column_invisible="1"/>
                                <field name="dependency_order_id" optional="hide"/>
                                <button name="action_open_details" string="Details" type="object"/>
                                <button name="action_review_payments" string="Review Payments" type="object" groups="account.group_account_manager"
                                        invisible="not current_order_id or reconciliation_status == 'matched'"/>
                                <button name="action_open_accounting_documents" string="Invoices / Credits" type="object" invisible="not current_order_id"/>
                                <button name="action_import_customer" string="Import Customer" type="object" groups="account.group_account_manager"
                                        invisible="not can_import_customer"/>
                                <button name="action_open_dependency_order" string="Dependency in Shopify" type="object" invisible="not dependency_order_id"/>
                                <button name="action_review_dependency_import" string="Review Order Import" type="object" groups="account.group_account_manager" invisible="not dependency_order_id"/>
                                <button name="action_open_order" string="Open Order" type="object" invisible="not current_order_id"/>
                                <button name="action_open_shopify_order" string="Shopify" type="object" invisible="dependency_order_id"/>
                                <button name="action_refresh_case" string="Refresh Case" type="object" groups="account.group_account_manager"/>
                            </list>
                        </field>
                    </group>
                    <group string="Repair History">
                        <field name="repair_history_ids" readonly="1" nolabel="1">
                            <list create="false" edit="false" delete="false" default_order="id desc">
                                <field name="create_date"/><field name="create_uid"/><field name="source_reference"/>
                                <field name="operation"/><field name="status"/><field name="reconciliation_status"/>
                                <field name="detail" optional="hide"/>
                                <button name="action_open_order" string="Open Order" type="object"/>
                                <button name="action_open_shopify_order" string="Shopify" type="object"/>
                            </list>
                            <form create="false" edit="false" delete="false">
                                <group><field name="create_date"/><field name="create_uid"/><field name="source_reference"/>
                                    <field name="operation"/><field name="status"/><field name="reconciliation_status"/>
                                    <field name="order_id"/><field name="payment_ids" widget="many2many_tags"/>
                                    <field name="credit_ids" widget="many2many_tags"/>
                                    <field name="collection_move_ids" widget="many2many_tags"/></group>
                                <field name="detail"/><field name="plan" widget="jsonb"/><field name="review_evidence" widget="jsonb"/>
                            </form>
                        </field>
                    </group>
                    <group string="Applied Accounting">
                    <field name="repair_audit_ids" readonly="1">
                        <list create="false" edit="false" delete="false">
                            <field name="create_date"/><field name="create_uid"/><field name="source_order_id"/>
                            <field name="order_id"/>
                            <field name="credit_ids" widget="many2many_tags"/><field name="payment_ids" widget="many2many_tags"/>
                            <field name="collection_move_ids" widget="many2many_tags"/>
                        </list>
                        <form create="false" edit="false" delete="false">
                            <group><field name="create_date"/><field name="create_uid"/><field name="source_order_id"/>
                                <field name="order_id"/><field name="payment_audit_id"/>
                                <field name="credit_ids" widget="many2many_tags"/><field name="payment_ids" widget="many2many_tags"/>
                                <field name="collection_move_ids" widget="many2many_tags"/><field name="transaction_ids" widget="many2many_tags"/></group>
                            <field name="plan" widget="jsonb"/>
                        </form>
                    </field>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='payout_transaction_ids']/list" position="inside">
                <button name="action_open_order" string="Open Order" type="object" invisible="not source_order_id and not order_id"/>
                <button name="action_open_shopify_order" string="Shopify" type="object" invisible="not source_order_id"/>
            </xpath>
            <xpath expr="//field[@name='payout_transaction_ids']/form" position="inside">
                <footer><button name="action_open_order" string="Open Order" type="object" invisible="not source_order_id and not order_id"/>
                    <button name="action_open_shopify_order" string="Shopify" type="object" invisible="not source_order_id"/></footer>
            </xpath>
        </field>
    </record>
    <record id="action_bulk_shopify_payout_repairs" model="ir.actions.server">
        <field name="name">Bulk Repair Payout Transactions</field>
        <field name="model_id" ref="model_shopify_payout_report_ept"/>
        <field name="binding_model_id" ref="model_shopify_payout_report_ept"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_manager'))]"/>
        <field name="state">code</field>
        <field name="code">if records:
    action = records.action_bulk_repair_transactions()</field>
    </record>
</odoo>
