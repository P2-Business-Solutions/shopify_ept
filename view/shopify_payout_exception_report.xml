<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="shopify_payout_exception_report_company_rule" model="ir.rule">
        <field name="name">Shopify payout exception report company</field>
        <field name="model_id" ref="model_shopify_payout_exception_report_ept"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="view_shopify_payout_exception_report_search" model="ir.ui.view">
        <field name="name">shopify.payout.exception.report.search</field>
        <field name="model">shopify.payout.exception.report.ept</field>
        <field name="arch" type="xml">
            <search string="Payout Reconciliation Exceptions">
                <field name="payout_id"/>
                <field name="payout_reference_id"/>
                <field name="instance_id"/>
                <field name="source_reference"/>
                <field name="source_order_id"/>
                <field name="source_order_transaction_id"/>
                <field name="shopify_transaction_id"/>
                <field name="stage"/>
                <field name="resolution"/>
                <filter name="open" string="Open Exceptions" domain="[('is_open', '=', True)]"/>
                <filter name="resolved" string="Resolved" domain="[('stage', '=', 'resolved')]"/>
                <separator/>
                <filter name="transaction_work" string="Transaction Work" domain="[('scope', 'in', ['transaction', 'statement'])]"/>
                <filter name="closeout_work" string="Validation / Bank Settlement" domain="[('scope', '=', 'payout')]"/>
                <separator/>
                <filter name="no_case" string="No Saved Repair Case" domain="[('scope', '=', 'transaction'), ('case_id', '=', False)]"/>
                <filter name="ready" string="Ready Cases" domain="[('case_status', '=', 'ready')]"/>
                <filter name="needs_review" string="Cases Needing Review" domain="[('case_status', '=', 'review')]"/>
                <filter name="applied" string="Applied / Awaiting Match" domain="[('case_status', '=', 'done'), ('stage', '=', 'unmatched')]"/>
                <separator/>
                <filter name="payout_date" string="Payout Date" date="payout_date"/>
                <group expand="0" string="Group By">
                    <filter name="group_payout" string="Payout" context="{'group_by': 'payout_id'}"/>
                    <filter name="group_stage" string="Exception Stage" context="{'group_by': 'stage'}"/>
                    <filter name="group_issue" string="Repair Issue" context="{'group_by': 'resolution'}"/>
                    <filter name="group_store" string="Store" context="{'group_by': 'instance_id'}"/>
                    <filter name="group_currency" string="Currency" context="{'group_by': 'currency_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_shopify_payout_exception_report_list" model="ir.ui.view">
        <field name="name">shopify.payout.exception.report.list</field>
        <field name="model">shopify.payout.exception.report.ept</field>
        <field name="arch" type="xml">
            <list string="Payout Reconciliation Exceptions" create="false" edit="false" delete="false"
                  decoration-success="stage == 'resolved'" default_order="payout_date asc, payout_id asc, id asc">
                <field name="payout_date"/>
                <field name="payout_id"/>
                <field name="instance_id" optional="hide"/>
                <field name="scope" optional="hide"/>
                <field name="stage"/>
                <field name="resolution" optional="show"/>
                <field name="case_status" optional="hide"/>
                <field name="source_reference" optional="show"/>
                <field name="source_order_id" optional="hide"/>
                <field name="order_id" optional="hide"/>
                <field name="transaction_type" optional="hide"/>
                <field name="amount" optional="hide"/>
                <field name="remaining_amount" optional="show"/>
                <field name="currency_id" optional="show"/>
                <field name="summary" optional="hide"/>
                <field name="next_step" optional="show"/>
                <field name="shopify_transaction_id" optional="hide"/>
                <field name="source_order_transaction_id" optional="hide"/>
                <field name="last_preview_at" optional="hide"/>
                <field name="last_apply_at" optional="hide"/>
                <field name="last_reimport_at" optional="hide"/>
                <field name="case_id" column_invisible="True"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <button name="action_open_case" string="Repair Details" type="object" invisible="not case_id"/>
                <button name="action_open_payout" string="Payout" type="object"/>
            </list>
        </field>
    </record>

    <record id="view_shopify_payout_exception_report_form" model="ir.ui.view">
        <field name="name">shopify.payout.exception.report.form</field>
        <field name="model">shopify.payout.exception.report.ept</field>
        <field name="arch" type="xml">
            <form string="Payout Reconciliation Exception" create="false" edit="false" delete="false">
                <header>
                    <button name="action_open_payout" string="Open Payout" type="object" class="btn-primary"/>
                    <button name="action_open_case" string="Repair Details" type="object" invisible="not case_id"/>
                    <button name="action_open_workspace" string="Open Repair Workspace" type="object"
                            groups="account.group_account_manager" invisible="scope != 'transaction'"/>
                    <button name="action_open_statements" string="Statement Transactions" type="object"/>
                    <button name="action_open_shopify_order" string="Shopify Order" type="object" invisible="not transaction_id or not source_order_id"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="payout_id"/><field name="payout_date"/><field name="payout_reference_id"/>
                            <field name="instance_id"/><field name="company_id" groups="base.group_multi_company"/>
                            <field name="payout_amount"/><field name="currency_id"/>
                        </group>
                        <group>
                            <field name="scope"/><field name="is_open"/><field name="stage"/>
                            <field name="resolution"/><field name="case_status"/>
                            <field name="summary"/><field name="next_step"/>
                        </group>
                    </group>
                    <group string="Exact Source and Statement References" invisible="scope == 'payout'">
                        <group><field name="transaction_id"/><field name="shopify_transaction_id"/>
                            <field name="source_order_transaction_id"/><field name="transaction_type"/>
                            <field name="source_order_id"/><field name="source_reference"/><field name="order_id"/></group>
                        <group><field name="amount"/><field name="remaining_amount"/>
                            <field name="statement_id"/><field name="statement_count"/>
                            <field name="case_id"/><field name="last_preview_at"/><field name="last_apply_at"/></group>
                    </group>
                    <notebook>
                        <page string="Current Evidence">
                            <field name="detail"/><field name="last_error"/>
                            <field name="evidence_html" nolabel="1"/><field name="review_html" nolabel="1"/>
                        </page>
                        <page string="Repair History">
                            <field name="history_ids" nolabel="1">
                                <list create="false" edit="false" delete="false" default_order="id desc">
                                    <field name="create_date"/><field name="create_uid"/><field name="source_reference"/>
                                    <field name="operation"/><field name="status"/><field name="reconciliation_status"/>
                                    <field name="detail" optional="show"/>
                                </list>
                                <form create="false" edit="false" delete="false">
                                    <group><field name="create_date"/><field name="create_uid"/><field name="workspace_id"/>
                                        <field name="case_id"/><field name="source_reference"/><field name="source_order_id"/>
                                        <field name="operation"/><field name="status"/><field name="reconciliation_status"/>
                                        <field name="order_id"/><field name="payment_ids" widget="many2many_tags"/>
                                        <field name="credit_ids" widget="many2many_tags"/><field name="collection_move_ids" widget="many2many_tags"/></group>
                                    <field name="detail"/><field name="plan" widget="jsonb"/><field name="review_evidence" widget="jsonb"/>
                                </form>
                            </field>
                        </page>
                        <page string="Saved Cases">
                            <field name="case_ids" nolabel="1" context="{'active_test': False}">
                                <list create="false" edit="false" delete="false" default_order="id desc">
                                    <field name="active"/><field name="wizard_id"/><field name="source_reference"/>
                                    <field name="status"/><field name="reconciliation_status"/><field name="resolution"/>
                                    <field name="last_preview_at"/><field name="last_apply_at"/><field name="summary"/>
                                    <button name="action_open_details" string="Details" type="object"/>
                                </list>
                            </field>
                        </page>
                        <page string="Applied Accounting">
                            <field name="audit_ids" nolabel="1">
                                <list create="false" edit="false" delete="false" default_order="id desc">
                                    <field name="create_date"/><field name="create_uid"/><field name="source_order_id"/>
                                    <field name="order_id"/><field name="payment_audit_id"/>
                                    <field name="credit_ids" widget="many2many_tags"/><field name="payment_ids" widget="many2many_tags"/>
                                    <field name="collection_move_ids" widget="many2many_tags"/>
                                </list>
                                <form create="false" edit="false" delete="false">
                                    <group><field name="create_date"/><field name="create_uid"/><field name="source_order_id"/>
                                        <field name="order_id"/><field name="payment_audit_id"/>
                                        <field name="transaction_ids" widget="many2many_tags"/><field name="credit_ids" widget="many2many_tags"/>
                                        <field name="payment_ids" widget="many2many_tags"/><field name="collection_move_ids" widget="many2many_tags"/></group>
                                    <field name="plan" widget="jsonb"/>
                                </form>
                            </field>
                        </page>
                        <page string="Payout Processing and Bank Settlement">
                            <group><field name="last_reimport_at"/><field name="last_reimport_result"/>
                                <field name="processing_issue"/><field name="settlement_status"/><field name="settlement_move_id"/></group>
                            <field name="settlement_bank_line_ids" nolabel="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="date"/><field name="payment_ref"/><field name="journal_id"/>
                                    <field name="amount"/><field name="is_reconciled"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shopify_payout_exception_report" model="ir.actions.act_window">
        <field name="name">Payout Reconciliation Exceptions</field>
        <field name="res_model">shopify.payout.exception.report.ept</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_shopify_payout_exception_report_search"/>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No open payout reconciliation exceptions in this scope.</p>
            <p>Clear Open Exceptions to inspect resolved transactions and their saved repair history.</p>
        </field>
    </record>

    <record id="view_shopify_payout_exception_report_button" model="ir.ui.view">
        <field name="name">shopify.payout.exception.report.button</field>
        <field name="model">shopify.payout.report.ept</field>
        <field name="inherit_id" ref="shopify_payout_report_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_exception_report" string="Reconciliation Exceptions" type="object"
                        groups="account.group_account_user"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_shopify_payout_exception_report" name="Payout Reconciliation Exceptions"
              parent="shopify_ept.shopify_menu_item_sales" groups="account.group_account_user"
              action="action_shopify_payout_exception_report" sequence="8"/>
</odoo>
